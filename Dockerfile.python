# Use Python 3.11 as the base image (more compatible with ML libraries)
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    g++ \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements file
COPY requirements.txt .

# Install Python dependencies
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy Python code
COPY climate_economy_ecosystem ./climate_economy_ecosystem
COPY graph ./graph
COPY setup_rlhf_tables.py ./
COPY setup_supabase_tables.py ./

# Create directories for data
RUN mkdir -p /app/data/vectors

# Set environment variables
ENV PYTHONPATH="/app"
ENV PYTHONUNBUFFERED=1

# Command to keep the container running
CMD ["tail", "-f", "/dev/null"]
